# ==========================================
# DATABASE (MongoDB Atlas)
# ==========================================
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/todoist_portal?retryWrites=true&w=majority"

# ==========================================
# NEXTAUTH CONFIGURATION
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-32-byte-base64-secret"

# ==========================================
# OAUTH PROVIDERS
# ==========================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

APPLE_ID="com.yourcompany.todoistportal.service"
APPLE_SECRET="your-generated-apple-client-secret-jwt"

# ==========================================
# VERCEL CRON SECURITY
# ==========================================
# Generate via: openssl rand -hex 32
CRON_SECRET="replace-with-cron-bearer-secret"

# Optional timezone for cron evaluation (defaults to America/New_York)
REMINDER_TIMEZONE="America/New_York"
